####################################
# 仓库级忽略规则
# 各模板工程（前端 / 后端）另有各自的 .gitignore
####################################

####################################
# IDE
####################################
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.classpath
.project
.settings/

####################################
# 压缩包（模板工程请以源码目录形式提交，不要提交打包文件）
####################################
*.7z
*.zip
*.rar
*.tar
*.tar.gz
*.tgz

####################################
# 日志与临时文件
####################################
*.log
*.tmp
*.bak
*.swp
*~

####################################
# 操作系统
####################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
