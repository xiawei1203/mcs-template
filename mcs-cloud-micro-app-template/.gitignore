####################################
# 依赖（子应用 + main 主应用各自的 node_modules）
####################################
node_modules/
.pnp
.pnp.js
jspm_packages/
web_modules/

####################################
# 构建产物
# 注意：outputDir 为 vue.config.js 中的 name + "-build"
# main/www 是基座主应用的预编译资源，本地调试必需，不可忽略
####################################
/dist/
/*-build/
/build/

####################################
# 缓存
####################################
.cache/
.temp/
.tmp/
.eslintcache
.stylelintcache
.parcel-cache/
.vite/
*.tsbuildinfo

####################################
# 测试与覆盖率
####################################
/coverage/
/tests/e2e/videos/
/tests/e2e/screenshots/
*.lcov
.nyc_output/

####################################
# 本地环境变量（.env.development / .env.production 需提交）
####################################
.env.local
.env.*.local

####################################
# 日志
####################################
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

####################################
# 编辑器与 IDE
####################################
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

####################################
# 压缩包
####################################
*.zip
*.7z
*.rar
*.tar
*.tar.gz

####################################
# 操作系统
####################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
