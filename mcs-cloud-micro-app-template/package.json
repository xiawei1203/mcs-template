{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently \"node main/app.js\" \"vue-cli-service serve\" ",
    "dev": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "core-js": "^3.8.3",
    "element-plus": "http://192.168.0.144:3000/cloud/mcs-cloud-element-plus/archive/2.4.tar.gz",
    "js-base64": "^3.7.5",
    "json-bigint": "^1.0.0",
    "path-browserify": "^1.0.1",
    "stream-browserify": "^3.0.0",
    "vue": "^3.2.13",
    "vue-router": "^4.0.8",
    "vuex": "^4.0.2",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "^5.0.8",
    "@vue/cli-plugin-vuex": "^5.0.8",
    "@vue/cli-service": "~5.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vue-template-compiler": "^2.6.14",
    "sass": "^1.49.8",
    "sass-loader": "^12.6.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "vue/setup-compiler-macros": true
    },
    "globals": {
      "__webpack_public_path__": "writable"
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "no-unused-vars": [
        "error",
        {
          "args": "none",
          "caughtErrors": "none"
        }
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
